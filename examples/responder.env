# Classifier environment (systemd EnvironmentFile)
# Base URL of the Prometheus the classifier queries for dashboards/verification
RESPONDER_PROM_URL=http://prometheus.internal:9090
# Optional sites/groups JSON for the dashboard's org display names
#RESPONDER_SITES_CONFIG=/etc/responder/sites.json

# Runbook environment (exported into agent sessions)
RESPONDER_DOMAIN=example.internal
RESPONDER_HYPERVISORS="hv-01.example.internal hv-02.example.internal"
LOKI_URL=http://loki.internal:3100
VANTAGE_2=checker.example.internal
